    {
      "id": "claim_95be5c3ec2f8437ea0c1ce21e2d15334",
      "statement": "create_review only accepts a review for a resource currently in pending_review status, and maps ReviewVerdict.approved to PubResourceStatus.approved while both ReviewVerdict.rejected and ReviewVerdict.needs_revision map the resource to PubResourceStatus.rejected; only guarantor or superadmin roles may create a review, enforced by validate_guarantor_or_superadmin which does not grant the resource owner access.",
      "evidence": [
        {
          "resource": "repo://backend/api/authorization.py#L103-L120",
