    {
      "id": "claim_142588a9a3e440f5910cd801dc626d56",
      "statement": "The publicDB feature (resources, reviews, rating, collections sub-packages under backend/api/src/publicDB/) exposes public (unauthenticated) routers for listing resources and public collections separately from authenticated routers, mirroring the courses public/private router split; the public routers are mounted in backend/api/src/routers.py without an auth dependency while resources_router, review_router, rating_router, and collections_router are mounted with Depends(auth.get_current_user).",
      "evidence": [
        {
          "resource": "repo://backend/api/src/publicDB/collections/routers.py#L27-L37",
          "version": "repo-lines-v1:sha256:ca94e58d162c68578e31919b304b873289e9133250da05d64adbdddb992b3bf9:"
