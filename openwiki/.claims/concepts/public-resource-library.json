      "id": "claim_6b90f4f5da3542c2a46679394199f77f",
      "statement": "PubResource has a PubResourceStatus lifecycle (draft, pending_review, approved, rejected). update_resource_status only allows draft->pending_review and rejected->pending_review transitions, and a rejected resource can only be resent for review if its most recent active PubResourceReview has verdict needs_revision.",
      "evidence": [
        {
          "resource": "repo://backend/api/enums.py#L73-L78",
          "version": "repo-lines-v1:sha256:c9992b1e00b3da3c818ba618d18aa86888f153db2b62cf71d98d517b955deaae:"
