    {
      "id": "claim_4d98b4f60a0d4258bb993641dfcaa6e3",
      "statement": "useAuth (frontend/src/hooks/useAuth.ts) synchronously hydrates auth state from localStorage before paint via useLayoutEffect, schedules a proactive token refresh ~60s before expiry, refreshes on tab-visibility regain, and synchronizes multiple mounted instances through the window events 'kc:logout' and 'kc:login' plus a module-level singleton refresh (getValidAccessToken) that collapses concurrent refresh calls into a single request.",
      "evidence": [
