    {
      "id": "claim_20b17a47856a485a950e83bfef4d18a6",
      "statement": "frontend/src/api is entirely generated by the openapitools/openapi-generator-cli typescript-fetch generator via the `generate:openapi` npm script, which fetches the schema from a running backend's http://localhost:8000/openapi.json, and the directory (marked by .openapi-generator-ignore/.openapi-generator metadata) must never be hand-edited.",
      "evidence": [
        {
          "resource": "repo://frontend/openapitools.json",
