    {
      "id": "claim_2e1e7600f35c4de89b5381d304fb9696",
      "statement": "backend/api/storage/seaweedfs.py provides synchronous upload_file/download_file/delete_file helpers that each build a URL via the configured filer_url and a remote path, use a short-lived httpx.Client, and let httpx.HTTPStatusError propagate on failure with no retry or caching; upload_file posts multipart/form-data matching the filer's curl -F contract and returns the full filer URL persisted as file_path.",
      "evidence": [
        {
          "resource": "repo://backend/api/storage/seaweedfs.py#L1-L78",
