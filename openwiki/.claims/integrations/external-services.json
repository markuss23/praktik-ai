  "claims": [
    {
      "id": "claim_6d40aa42811f4955918e61c820d31691",
      "statement": "Keycloak is provisioned via compose.yml importing infra/keycloak/praktikai-dev-realm.json into a 'praktikai-dev' realm defining four realm roles (user, lector, guarantor, superadmin), a confidential client 'app' (service accounts enabled, direct access grants enabled) used by the backend for both token introspection and admin role lookups, and a public PKCE client 'praktik-ai-app' used by the frontend.",
      "evidence": [
        {
          "resource": "repo://compose.yml#L67-L98",
          "version": "repo-lines-v1:sha256:5603b23b4a1568f3ec9ef2dbef48ff903f4e297e6ca9616fc8dbc03cf2335782:"
        },
        {
          "resource": "repo://infra/keycloak/praktikai-dev-realm.json",
          "version": "repo-file-v1:sha256:2a1618bc38343bc2285ac8dd3e9bd80407b96e1eb136c89bca3ad6cd1267a943"
        }
      ]
    },
    {
      "id": "claim_d663dcf565c14f0298b3db0688806fd2",
      "statement": "backend/api/config.py's KeycloakSettings (server_url, realm_name, client_id, client_secret) is populated from KEYCLOAK__* environment variables and must match the 'app' client's id/secret in the imported realm JSON; SeaweedFSSettings (master_url, filer_url) defaults to the seaweedfs-master/filer service DNS names and is overridable via SEAWEEDFS__MASTER_URL/SEAWEEDFS__FILER_URL.",
      "evidence": [
        {
          "resource": "repo://backend/api/config.py#L16-L26",
          "version": "repo-lines-v1:sha256:733732283bcc0237b0040d864510a4703d60d134173227d17025f1c9a876a2b9:"
        }
      ]
    },
    {
      "id": "claim_29b2d15321c542dca6268a6c102eee79",
      "statement": "backend/api/dependencies.py's Auth class wraps python-keycloak's KeycloakOpenID as a module-level singleton: get_token() performs the password grant for the backend's own token endpoint, and get_current_user() introspects then reads userinfo() from the bearer token, using only sub/email/name from the JWT and never trusting embedded roles; a Keycloak connection/auth error during get_current_user surfaces as HTTP 500, failing all authenticated requests closed.",
      "evidence": [
        {
          "resource": "repo://backend/api/dependencies.py#L85-L154",
          "version": "repo-lines-v1:sha256:e5fbf8eb25496d54f898b8ef01fee17483d92067440fb3fa22702cbb5fdd7037:"
        }
      ]
    },
    {
      "id": "claim_5966d4dafed449c09e404313178080e4",
      "statement": "Role lookups are performed via python-keycloak's KeycloakAdmin authenticated through the client-credentials grant on the same 'app' client's service account (KeycloakOpenIDConnection); _fetch_roles_from_admin_api resolves the highest realm role via a fixed priority order and falls back to UserRole.user on any exception (e.g. Admin API unreachable), failing safe rather than blocking the request.",
      "evidence": [
        {
          "resource": "repo://backend/api/dependencies.py#L36-L82",
          "version": "repo-lines-v1:sha256:b28a782918b20a0fce07d16500806b660fae5c4b0f9ce208b77f7b78142f94cb:"
        }
      ]
    },
    {
      "id": "claim_fa95ce82cba540f1859bc949c601a49d",
      "statement": "get_current_user only re-invokes the Keycloak Admin API role lookup when a user row is first created or when now - user.last_synced_at exceeds a 5-minute TTL (_ROLE_SYNC_TTL), otherwise reusing the DB-cached role; a role change in Keycloak is visible to the backend within at most 5 minutes or immediately after a fresh /auth/sync call.",
      "evidence": [
        {
          "resource": "repo://backend/api/dependencies.py#L161-L232",
          "version": "repo-lines-v1:sha256:3e7402d9dc6b70c9930d664193829ca3cbab8c343ce2f0c17216b6a82bfbded2:"
