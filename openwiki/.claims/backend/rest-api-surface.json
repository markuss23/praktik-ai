    {
      "id": "claim_ef4c0e2698324b70944b07c9c1e6f008",
      "statement": "The courses, editor_images, and publicDB resources/collections domains each define two APIRouter instances in the same routers.py (an authenticated `router` and an anonymous `public_router`) sharing the same URL prefix, splitting endpoints by access requirement rather than by domain.",
