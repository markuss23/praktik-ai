    {
      "id": "claim_32fcc7c3ca604b04b34a74acf0799155",
      "statement": "The FastAPI app in backend/api/main.py sets docs_url=\"/\", serving Swagger UI at the API root, and mounts the aggregate router from api.src.routers under the /api/v1 prefix.",
      "evidence": [
        {
          "resource": "repo://backend/api/main.py#L28-L28",
          "version": "repo-lines-v1:sha256:d47ee30227e061769f94d477a8100b04195ca6fd70a009ac24f2e0ffb4f3d613:"
