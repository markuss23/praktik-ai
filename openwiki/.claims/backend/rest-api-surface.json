    {
      "id": "claim_885e46c6cb0a4e82859e6d79d694684e",
      "statement": "api/src/routers.py builds a single aggregate APIRouter that includes one router per business domain (courses, modules, activities, agents, auth, users, enrollments, feedbacks, catalogs, superadmin, module_tickets, editor_images, and publicDB's resources/reviews/rating/collections).",
      "evidence": [
        {
          "resource": "repo://backend/api/src/routers.py#L1-L70",
          "version": "repo-lines-v1:sha256:a3fec8dcf61d3b022c291fb8b3f4dfcac17bf25a7fd25efd264bbe952cda00f3:"
        }
      ]
    },
    {
      "id": "claim_b42a88b90fbb41d78f5e339841734bd0",
      "statement": "In api/src/routers.py, auth, courses_public, catalogs, resources_public, editor_images_public, and collections_public routers are included without the auth dependency, while every other domain router is included with dependencies=[Depends(auth.get_current_user)], making authentication mandatory for all their routes.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/routers.py#L33-L70",
          "version": "repo-lines-v1:sha256:ae357af05edf2ccc2479d636ceae29ea5c448d7c0750329c981695b66655b1b8:"
