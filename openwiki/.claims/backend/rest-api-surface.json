    {
      "id": "claim_cfded242d2f045f4ac11166cbfab8df2",
      "statement": "api/src/common/utils.py defines check_enrollment, which raises HTTPException(403) unless the user has an active Enrollment (is_active=True, left_at is null) for the course, with an optional bypass_for_owner flag that lets the course owner or a superadmin skip the check.",
      "evidence": [
        {
