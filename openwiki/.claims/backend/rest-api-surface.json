    {
      "id": "claim_dc3101e57603433ab7ae9642b3cd127d",
      "statement": "api/src/common/utils.py defines attachment_response, which builds a file-download Response carrying both an ASCII-transliterated fallback filename and an RFC 5987 filename*=UTF-8'' encoded original filename in Content-Disposition, plus Access-Control-Expose-Headers, to avoid header-encoding failures with diacritics.",
      "evidence": [
