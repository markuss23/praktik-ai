        }
      ]
    },
    {
      "id": "claim_88bcb3eed0d4420d947597e445af5663",
      "statement": "Keycloak is configured to use the same Postgres database as the backend, in a dedicated 'keycloak' schema created via CREATE SCHEMA IF NOT EXISTS keycloak, both by infra/docker/init-db.sql (run once on Postgres init) and redundantly inside seed_db() on every API start.",
