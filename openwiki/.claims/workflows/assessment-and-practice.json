    {
      "id": "claim_f2da92632c424f9ab398dfab09b39015",
      "statement": "Each call to generate_practice_question creates a new UserPracticeQuestion row (a personalized, per-user variant of module content) rather than reusing a prior one, and practice_question_generator selects distinct SystemSetting keys/prompts for open vs. closed question types while sharing the same default model gpt-4o.",
      "evidence": [
