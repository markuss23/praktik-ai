    {
      "id": "claim_3d4fc9ad9e534c2e944ffa989da8d9eb",
      "statement": "For closed practice questions, generate_question requires the LLM to answer in a QUESTION:/A:/B:/C:/D:/CORRECT: format and sets state['error'] if parsing does not yield exactly 4 options with a valid CORRECT letter, which short-circuits the graph before persist_question runs; persisted options are stored as a JSON list of {text, is_correct}.",
      "evidence": [
        {
          "resource": "repo://backend/agents/practice_question_generator/nodes/generate_question.py#L66-L101",
          "version": "repo-lines-v1:sha256:850c40d10991330a27e35aaa22fb7a2a3b651a2132718983070adc6ac885624e:"
