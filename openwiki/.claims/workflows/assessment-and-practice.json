    {
      "id": "claim_38e7e102f44a4c4d8206b541ec308202",
      "statement": "evaluate_practice_answer rejects further submissions to a UserPracticeQuestion with HTTP 409 once any prior UserPracticeAttempt on it has is_correct=True, and otherwise branches purely on question_type: closed questions are graded deterministically in _evaluate_closed by comparing user input to the option flagged is_correct in the stored options snapshot without any LLM call, while open questions are graded by the practice_answer_evaluator LangGraph agent.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/practice_controllers.py#L62-L156",
          "version": "repo-lines-v1:sha256:4b02781b26c2db7a98f68b8f742c3fc8d221a3ddfd653c8723712f84b8826706:"
