    {
      "id": "claim_cb91fe4f0bd14f6fab720b9b5861ea30",
      "statement": "ModuleTicket has a partial unique DB index uq_ticket_user_module_type keyed on (user_id, module_id, ticket_type) where status='open', but create_ticket's application-level pre-check rejects a new ticket whenever the user already has any open ticket for the module regardless of ticket_type, making the enforced business rule broader ('one open ticket per user per module') than the DB index alone would guarantee.",
      "evidence": [
