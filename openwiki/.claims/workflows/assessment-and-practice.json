  "claims": [
    {
      "id": "claim_0c03c60f53db43cd9366d0ec5f0d7619",
      "statement": "The assessment_generator, assessment_evaluator, practice_question_generator, and practice_answer_evaluator agents are each a LangGraph StateGraph with a load_context -> generate/evaluate -> persist node chain, wired with a conditional edge that skips remaining nodes and routes to END if load_context (or, for practice_question_generator, generate_question on malformed closed-question output) sets an 'error' key in state.",
      "evidence": [
        {
          "resource": "repo://backend/agents/assessment_evaluator/graph.py",
          "version": "repo-file-v1:sha256:20c3205038d2e5921b73459631dfed41cf6641f098d7eb676a9f2eb1daa8db2f"
        },
        {
