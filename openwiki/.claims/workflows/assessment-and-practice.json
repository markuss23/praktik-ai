    {
      "id": "claim_83918dd38b40422fab2920f6aad081d6",
      "statement": "practice_answer_evaluator's evaluate_answer node prompts the LLM for a CORRECT:/FEEDBACK: format with an encouraging, non-adversarial feedback style (praises correct answers, only hints at gaps) and produces only a boolean is_correct with no numeric score, contrasting with the stricter, adversarial scoring used by assessment_evaluator.",
      "evidence": [
