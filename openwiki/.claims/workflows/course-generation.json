    },
    {
      "id": "claim_f05134b4c9a1440e9b8efb006d7db767",
      "statement": "GET /agents/active-course-generation lists currently running course_ids via list_running_course_ids and returns the first one owned by the requesting user (or any, for superadmin), letting the frontend resume progress polling after a full page reload.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/progress.py#L100-L103",
