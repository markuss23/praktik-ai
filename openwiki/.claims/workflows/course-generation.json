    },
    {
      "id": "claim_7d31f1bbbf784ac6ae9a339cf3571681",
      "statement": "The course_generator agent's structured LLM output is constrained by Pydantic schemas in state.py (CourseGenerated, ModuleGenerated, LearnBlockGenerated, PracticeQuestionGenerated), which are separate from the API response schemas and used only to shape the LLM's output before persistence.",
      "evidence": [
        {
          "resource": "repo://backend/agents/course_generator/state.py#L13-L47",
          "version": "repo-lines-v1:sha256:8893651322af1c2bf1d2d2c63dd22a535b6e651969d6f693276fa88aafe5eba9:"
