    },
    {
      "id": "claim_0e3a01bf10404ce98e4432b22208d3bb",
      "statement": "plan_content_node loads the 'course_planner' LLM configuration and uses model.with_structured_output(CourseGenerated, method='json_schema') to force server-side structured output enforcement (rather than tool-calling) because the nested modules/learn_blocks/practice_questions schema otherwise risks the model returning nested arrays as JSON-encoded strings; it raises ValueError if the returned course has no modules.",
      "evidence": [
        {
          "resource": "repo://backend/agents/course_generator/nodes/planner.py#L6-L63",
          "version": "repo-lines-v1:sha256:c6a14afb530e401ad2848727b2198a71eef27163475dfdd152d808485fc7dc2b:"
