    {
      "id": "claim_74863bbc703f4c66acb404bb5c71a4e0",
      "statement": "summarize_content_node loads the 'course_summarizer' LLM configuration via get_llm_config, invokes a chat model with a prompt built from course metadata and source_content, and raises ValueError if the model returns an empty summary.",
      "evidence": [
        {
          "resource": "repo://backend/agents/course_generator/nodes/summarize.py#L9-L54",
