    {
      "id": "claim_7e29993b9145459c92721e69119ebeaf",
      "statement": "Because generate_course only awaits scheduling the background task (not the generation itself), the HTTP request completes immediately and generation continues on the server independent of the client connection, so a page refresh does not interrupt it; GET /agents/course-progress/{course_id} lets any subsequent request resume observing the same in-flight task via the progress registry.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/routers.py#L123-L148",
          "version": "repo-lines-v1:sha256:17ae80f52a8d29ce7ff55283d287f791950c5b4addfcd499ce6347141ed59dfd:"
