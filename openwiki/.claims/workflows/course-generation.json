    },
    {
      "id": "claim_bbb26fd1b39149a38bfc5c5bc47a8b48",
      "statement": "The course_generator LangGraph pipeline is a linear StateGraph with entry point load_data_db and sequential edges load_data_db -> load_data -> summarize_content -> plan_content -> save_to_db -> END.",
      "evidence": [
        {
          "resource": "repo://backend/agents/course_generator/graph.py#L13-L37",
          "version": "repo-lines-v1:sha256:1ea607f6f9593915e103ef53825ce954604621e4516a6206c7c23802e72cc8ac:"
        }
      ]
    },
    {
      "id": "claim_ee8b0e435f53499ab40d8e507f7aece2",
      "statement": "load_data_db_node loads the Course row and its CourseFile rows from the database into CourseInput, raising ValueError if the course is not found.",
      "evidence": [
        {
          "resource": "repo://backend/agents/course_generator/nodes/load_data_db.py#L11-L50",
