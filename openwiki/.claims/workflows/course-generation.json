    },
    {
      "id": "claim_abe98e2ace264423acf52bdd25c5fc34",
      "statement": "register_task/unregister_task keep a strong reference to the running asyncio.Task so it is not garbage collected, and is_running(course_id) checks whether that task exists and is not yet done, which backs the idempotency guard in generate_course.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/progress.py#L82-L97",
          "version": "repo-lines-v1:sha256:e289fa2485464a8b798d2522f687e18ca33ff563d053ad16d53a7dc5c800328b:"
        }
