        }
      ]
    },
    {
      "id": "claim_762716c8b95a48fd9b2e70870395ec11",
      "statement": "load_data_node downloads each course file from SeaweedFS, extracts text via DataLoader, concatenates results into source_content, and raises if no file could be loaded at all (individual per-file failures are only logged).",
      "evidence": [
        {
          "resource": "repo://backend/agents/course_generator/nodes/load_data.py#L11-L49",
          "version": "repo-lines-v1:sha256:891bd98af0c806ff0dd532d47e8a7d49c1a96b0dbeecefee7203c43ad082f540:"
