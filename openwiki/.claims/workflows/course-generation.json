  "claims": [
    {
      "id": "claim_5d5aa3083d6a4bdd80980bbf69b2200c",
      "statement": "POST /agents/generate-course requires the lector role, validates course ownership (owner or superadmin), and only allows generation when Course.status is 'draft' or 'failed', rejecting other statuses with HTTP 400.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/routers.py#L87-L120",
          "version": "repo-lines-v1:sha256:082add488cc4b8ad16fc469038a37ec73cfbace385fcd0aa497689f7d851246a:"
        }
      ]
    },
    {
      "id": "claim_9c6a1f3a184c4c6d8950abec0db930b7",
      "statement": "generate_course enforces idempotency against duplicate concurrent generation for the same course_id: if is_running(course_id) is true, it returns immediately with an empty response instead of scheduling a new background task.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/progress.py#L93-L97",
          "version": "repo-lines-v1:sha256:eda8c5e176aa0239b26f3fc86cf65f7e1815c05ecfbfecaf01cae4fedac3b155:"
        },
        {
          "resource": "repo://backend/api/src/agents/routers.py#L111-L120",
          "version": "repo-lines-v1:sha256:f4c073519e83c5931e0dd6fa90d0c68a741157a1d9c23717e8bfa7519e166a43:"
        }
      ]
    },
    {
      "id": "claim_e209af19f8814df0984534e16ed1666f",
      "statement": "generate_course schedules course generation as a detached asyncio.create_task running _run_course_generation, registers it in the progress module's task registry, and returns before generation completes so the client polls for progress separately.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/routers.py#L116-L120",
          "version": "repo-lines-v1:sha256:a34871077736e685bf2107804d509f77e3ffb43a00182ef8e071b7460b8204b0:"
        }
      ]
    },
    {
      "id": "claim_ef4d4ddf1cd14a7792be7b1624bc3af9",
      "statement": "_run_course_generation opens its own SQLAlchemy session via SessionLocal() (independent of the original request's session) because it must outlive the HTTP request that triggered it.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/routers.py#L56-L67",
          "version": "repo-lines-v1:sha256:1a0fb69df9d6600c6339573737a64a9d22c9453316ba34ba6f23e10065c4445b:"
        }
      ]
    },
    {
      "id": "claim_c561f674ea694450bd30966ad0d3a5fd",
      "statement": "On any exception during course generation, _run_course_generation records the error via mark_failed, rolls back the background DB session, and issues a separate committed UPDATE setting Course.status to failed, ensuring the course does not remain stuck in an inconsistent state.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/routers.py#L68-L80",
          "version": "repo-lines-v1:sha256:55cc2cb1ba4dd6390b83807178a181f85750697db150daa7eb9d7c12b3f52687:"
        }
      ]
    },
    {
      "id": "claim_3ddcbee1d64a43e191f4c36b1b0c8a22",
      "statement": "_run_course_generation always closes its DB session and calls unregister_task in a finally block, regardless of success or failure, which resets is_running(course_id) to False and allows a later retry to start a new task.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/progress.py#L88-L97",
          "version": "repo-lines-v1:sha256:bc69c16825df2d2228bf13d5b527428ab821266d9bf31e486516dc2981a78d43:"
        },
        {
          "resource": "repo://backend/api/src/agents/routers.py#L82-L84",
          "version": "repo-lines-v1:sha256:872e3c19df6bd54004ad34ee35541235eabce92b2d5ee670c6c27755f6ed42ee:"
        }
      ]
    },
    {
      "id": "claim_3db1142808b54373898586360629b393",
      "statement": "Course generation progress and running-task state are tracked in an in-memory, process-local registry (api/src/agents/progress.py) guarded by a threading.Lock, storing GenerationProgress per course_id and live asyncio.Task references, and this state is lost on process restart.",
      "evidence": [
        {
          "resource": "repo://backend/api/src/agents/progress.py#L1-L30",
          "version": "repo-lines-v1:sha256:016b4542f728dfeb21d0c53a1b9609ea5947d727e2b75b8e7000aec49068ec9f:"
        }
      ]
    },
    {
      "id": "claim_4864bebe6fb24ba1b86d3293bbd965ab",
      "statement": "set_progress is called by each LangGraph node in the course_generator pipeline to advance a shared step counter and label used for client polling; mark_completed and mark_failed record the terminal state once the background task finishes.",
      "evidence": [
        {
          "resource": "repo://backend/agents/course_generator/nodes/load_data_db.py#L17-L17",
          "version": "repo-lines-v1:sha256:7432c117fdfbb036addfe57dca2adca7ca3957248cd1701f49f2c96a9895d758:"
