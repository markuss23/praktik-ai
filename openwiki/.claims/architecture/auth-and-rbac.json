    {
      "id": "claim_da81941d6ebd4c17afdd225bf6a54286",
      "statement": "authorization.py provides four ownership helpers built on a shared OwnedResource.get_owner_id() protocol and a 404-if-missing check: validate_ownership allows owner or (by default) guarantor/superadmin; validate_owner_or_superadmin allows only the owner or superadmin (guarantor excluded); validate_guarantor_or_superadmin allows only guarantor or superadmin regardless of ownership; validate_superadmin allows only superadmin.",
      "evidence": [
        {
          "resource": "repo://backend/api/authorization.py#L12-L120",
          "version": "repo-lines-v1:sha256:648aa3c52dc2f437925167ff00c0636ac464749db81761c680b7b88ff26c1d96:"
        }
