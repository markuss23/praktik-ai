        }
      ]
    },
    {
      "id": "claim_c4f8727252564a14a6b5ebe4970ca4ea",
      "statement": "_resolve_highest_role picks the single highest-ranked realm role a user holds using the fixed priority order ['user','lector','guarantor','superadmin'], and _fetch_roles_from_admin_api falls back to UserRole.user on any Keycloak Admin API failure rather than blocking the request.",
      "evidence": [
        {
          "resource": "repo://backend/api/dependencies.py#L36-L82",
