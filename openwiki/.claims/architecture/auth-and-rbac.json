    {
      "id": "claim_33a7d0e9a9e249dba5319cae99799d71",
      "statement": "require_role(min_role) is a minimum-role numeric gate (ROLE_HIERARCHY: user=1, lector=2, guarantor=3, superadmin=4) layered on top of get_current_user, so a check for a given role also passes for any higher role; it is applied per-router or per-endpoint via dependencies=[require_role(...)].",
      "evidence": [
        {
          "resource": "repo://backend/api/dependencies.py#L235-L252",
          "version": "repo-lines-v1:sha256:b002cb019e6f3022c638f9f408f7cb942a1b311fd7e9d765937028f85245d86c:"
