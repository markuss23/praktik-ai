    {
      "id": "claim_622beef218414e6bb30a7e7fa734a64c",
      "statement": "backend/api/src/routers.py mounts most sub-routers with a blanket dependencies=[Depends(auth.get_current_user)] at include_router time, enforcing authentication before any endpoint-specific require_role check runs; the auth router and the public catalog/resource/collection routers are deliberately mounted without this dependency to remain anonymously accessible.",
      "evidence": [
