  "claims": [
    {
      "id": "claim_94686231e7fe4414b4ba399beee1aa58",
      "statement": "The frontend runs a PKCE authorization-code OIDC flow directly against Keycloak (buildLoginUrl generates a code_verifier/code_challenge pair, redirects to Keycloak's /auth endpoint, and the /auth/callback page exchanges the returned code for tokens via exchangeCodeForTokens), rather than proxying login through the backend.",
      "evidence": [
        {
          "resource": "repo://frontend/src/app/auth/callback/page.tsx#L15-L50",
          "version": "repo-lines-v1:sha256:896c7a4aeaedf994c6f88dfb980a856fd5d296f0fac79abf4404c5ed8726c894:"
        },
        {
          "resource": "repo://frontend/src/lib/keycloak.ts#L28-L117",
          "version": "repo-lines-v1:sha256:7f61a7b9ac805396f2970b835d2ec8de8f1a30cd05ec3f0ac2f992af6efdec11:"
        }
      ]
    },
    {
      "id": "claim_fbf1d65308fa44b998d25054f2120336",
      "statement": "storeTokens() persists access/refresh/ID tokens and an expiresAt timestamp (now + expires_in - 30s) to localStorage and dispatches a 'kc:login' window event so other mounted useAuth instances pick up the new session without a reload; clearTokens() removes them and dispatches 'kc:logout' unless called silently.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/keycloak.ts#L201-L223",
          "version": "repo-lines-v1:sha256:1178c01c975ecc25126ee1595ccdf04e8561d2e2d89e22ffdb171ebab146a933:"
        }
      ]
    },
    {
      "id": "claim_4cdadd66ee3e4a91b64240bb51505b0b",
      "statement": "getValidAccessToken() is the funnel for obtaining a usable access token: it returns the stored token if not expiring (isTokenExpiring, default 60s buffer), otherwise refreshes via refreshTokens(), sharing concurrent refresh calls through a module-level _refreshPromise singleton so multiple mounted hook instances trigger only one POST /token instead of a duplicate-refresh race.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/keycloak.ts#L238-L277",
          "version": "repo-lines-v1:sha256:2c5b148a4e3da6178d624d1ab358518e8543664105469792cfee94f28b461b84:"
        }
      ]
    },
    {
      "id": "claim_6bc6bd3cc5ed47bba0b1566cca8bdc89",
      "statement": "useAuth() initializes synchronously from localStorage via useLayoutEffect to avoid a UI flash, schedules a proactive refresh timer 60s before expiry, refreshes on tab visibility change when the token is expiring, listens for cross-instance 'kc:logout'/'kc:login' events, and logout() redirects to Keycloak's RP-initiated /logout endpoint with id_token_hint.",
      "evidence": [
        {
          "resource": "repo://frontend/src/hooks/useAuth.ts#L53-L167",
          "version": "repo-lines-v1:sha256:1b61fd0d333905386af38ca29040c1497e164a24669f54e822ff3864ff736ebf:"
        }
      ]
    },
    {
      "id": "claim_ded81ce5775849feb8d9636a4a05a7c1",
      "statement": "parseJwt() decodes the JWT client-side without signature verification and resolves an effective UI-only role via resolveRole(), which returns the first matching role in superadmin > guarantor > lector > user order from realm_access.roles, defaulting to 'user'.",
      "evidence": [
        {
          "resource": "repo://frontend/src/lib/keycloak.ts#L140-L190",
          "version": "repo-lines-v1:sha256:52dc5a0596ab7ccbdfd56c54fb2eff0f73d2f46c44a034d3afc32cafc26307e3:"
        }
      ]
    },
    {
      "id": "claim_0bca3c37fa8142128c88d180bb7938ce",
      "statement": "Auth.get_current_user (the CurrentUser dependency) never reads roles from the JWT: it introspects the token for validity, calls userinfo() only for identity (sub/email/name), looks up the User by sub, and rejects deactivated users (is_active=False) with 403 regardless of Keycloak token validity.",
      "evidence": [
        {
          "resource": "repo://backend/api/dependencies.py#L117-L194",
          "version": "repo-lines-v1:sha256:a94bbca7279e87ec87219266c9bd0faf9d25a4a4bceaabc9cde0e9d2dbdee4f2:"
        }
      ]
    },
    {
      "id": "claim_c80ef805bd334eaeb265db5fad939fcf",
      "statement": "User role is (re)synced from the Keycloak Admin API only when the DB row is new or last_synced_at is older than the 5-minute _ROLE_SYNC_TTL, bounding Admin API call frequency while keeping Keycloak role changes eventually consistent in the app DB.",
      "evidence": [
        {
          "resource": "repo://backend/api/dependencies.py#L161-L189",
          "version": "repo-lines-v1:sha256:d27119e43eadbcf789a9f91a8d5c3b45d08bae766906982c8dedb08d3c385ef3:"
        },
        {
          "resource": "repo://backend/api/dependencies.py#L39-L39",
