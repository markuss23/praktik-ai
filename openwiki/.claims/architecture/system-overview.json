        }
      ]
    },
    {
      "id": "claim_70aeaf28118748b38a669db7dde918b5",
      "statement": "start_wiki_sync_scheduler registers a recurring wiki_sync job on an IntervalTrigger (default 12h via settings.wiki.sync_interval_hours) with replace_existing=True for idempotency, and additionally enqueues a one-off bootstrap sync job immediately if the pgvector wiki embedding collection is empty or its tables do not yet exist.",
      "evidence": [
