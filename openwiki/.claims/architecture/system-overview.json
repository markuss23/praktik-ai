        }
      ]
    },
    {
      "id": "claim_d9addb1059404317bb99d0e7b35adf7c",
      "statement": "Wiki sync jobs clone/pull a GitHub wiki repository into settings.wiki.local_path and re-index it via a LangGraph graph into pgvector; failures during sync are caught and logged rather than propagated, so a failed sync never crashes the API process.",
