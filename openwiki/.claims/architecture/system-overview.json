    {
      "id": "claim_8586aeb05edf49f8a00c2b228c5414a0",
      "statement": "The API registers a global exception handler for SQLAlchemy IntegrityError that logs the error and returns HTTP 400 with a generic constraint-violation message, and a catch-all Exception handler that logs a full traceback and returns HTTP 500 with a generic error message, preventing unhandled DB or application errors from leaking internals or crashing the process.",
      "evidence": [
