    {
      "id": "claim_202ab58801c04ea586c6fc2a73ec9611",
      "statement": "The FastAPI app uses an asynccontextmanager lifespan hook that calls start_wiki_sync_scheduler() on startup and stop_wiki_sync_scheduler() on shutdown, managing an APScheduler AsyncIOScheduler that runs a periodic wiki-sync job.",
      "evidence": [
        {
          "resource": "repo://backend/agents/wiki/agent/scheduler.py#L16-L86",
          "version": "repo-lines-v1:sha256:63e05765bd2fa08cef23a6f121688a23510ddea81a909c99af1e7a60bcbe73fa:"
