  "claims": [
    {
      "id": "claim_1ed4fdd0e2074f15b0227e3918a32e48",
      "statement": "SoftDeleteMixin.soft_delete() never issues SQL DELETE; it sets is_active=False on the instance and recursively calls soft_delete() on every related object listed in the model's _soft_delete_cascade, whether the relationship is a single object or a list.",
      "evidence": [
        {
          "resource": "repo://backend/api/models.py#L61-L82",
          "version": "repo-lines-v1:sha256:01a3a0dc4ee2ed6b7c987c55a57ac17688937f577cf55d26e46d43d1babf89a1:"
        }
      ]
    },
    {
      "id": "claim_7fb1292c5b684f3ba9d682a34ade913c",
      "statement": "Records are deactivated instead of hard-deleted because most foreign keys in the schema (e.g. Course.owner_id, Module.course_id, ModuleTicket user/module/course FKs) lack ON DELETE CASCADE and because historical rows such as Enrollment, TaskAttempt, ModuleTicket, and AuditLog must remain queryable after their parent record is retired.",
      "evidence": [
        {
          "resource": "repo://backend/api/models.py#L1339-L1396",
          "version": "repo-lines-v1:sha256:0f573937f44c3c64c13d2c1c4ab6eae08b3275af35db376d33a853e2e8bfbf82:"
