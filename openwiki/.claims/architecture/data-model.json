    {
      "id": "claim_3184256edab24759b801dc6ad78375cf",
      "statement": "AuditLog is a single system-wide table storing polymorphic references to any other table via table_name and a JSONB row_pk (GIN-indexed), plus action (AuditAction), changed_at, actor_id, and a JSONB diff; per its docstring it is intended to be populated from an application-level SQLAlchemy before_flush session listener rather than DB triggers specifically so the write can capture actor_id from the request-scoped current user, since a DB trigger has no access to the HTTP request's authenticated identity.",
      "evidence": [
        {
          "resource": "repo://backend/api/dependencies.py#L117-L194",
